{
  "name": "yet-another-tuner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A lightweight, private, browser-based guitar tuner with local audio processing.",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --max-warnings=0 && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "keywords": [
    "guitar",
    "tuner",
    "web-audio",
    "audio-worklet"
  ],
  "license": "MIT",
  "homepage": "https://megaboich.github.io/yet-another-tuner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megaboich/yet-another-tuner.git"
  },
  "bugs": {
    "url": "https://github.com/megaboich/yet-another-tuner/issues"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {},
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.9.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
